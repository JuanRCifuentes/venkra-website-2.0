---
// Temporary page to compare catalogue directions on the preview. Remove it
// once one is chosen.
import CatalogueA from '../components/catalogue/CatalogueA.astro';
import CatalogueB from '../components/catalogue/CatalogueB.astro';
import CatalogueC from '../components/catalogue/CatalogueC.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#000" />
		<meta name="color-scheme" content="dark" />
		<title>Venkra · Opciones de catálogo</title>
	</head>
	<body>
		<p class="label">Opción A · Índice editorial</p>
		<CatalogueA />
		<p class="label">Opción B · Pósters</p>
		<CatalogueB />
		<p class="label">Opción C · Banda y carrusel</p>
		<CatalogueC />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--font-display: 'Avenir Next Condensed', 'Arial Narrow', 'Roboto Condensed', Impact, sans-serif;
	}

	body {
		margin: 0;
		background: #000;
		font-family: system-ui, sans-serif;
	}

	.label {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0.75rem 1rem;
		background: #efe3c8;
		color: #000;
		font: 800 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
</style>
