---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import CatalogueMosaic from '../components/landing/CatalogueMosaic.astro';
import { categories } from '../data/categories';
---

<BaseLayout heroLogo=".hero-logo > svg">
	<link slot="head" rel="preload" href="/hero/poster.webp" as="image" type="image/webp" fetchpriority="high" />
	<main>
		<Hero />
		<CatalogueMosaic categories={categories} />
	</main>
</BaseLayout>
