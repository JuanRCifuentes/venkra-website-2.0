---
import Hero from '../components/Hero.astro';
import CatalogueC from '../components/catalogue/CatalogueC.astro';
import CatalogueE from '../components/catalogue/CatalogueE.astro';
import CatalogueG from '../components/catalogue/CatalogueG.astro';
import CatalogueH from '../components/catalogue/CatalogueH.astro';
import CatalogueI from '../components/catalogue/CatalogueI.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#000" />
		<meta name="color-scheme" content="dark" />
		<link rel="preload" href="/hero/poster.webp" as="image" type="image/webp" fetchpriority="high" />
		<title>Venkra</title>
	</head>
	<body>
		<main>
			<Hero />
			<!-- Temporary: catalogue directions to compare. Keep one. -->
			<p class="option-label">Opción C · Banda y carrusel</p>
			<CatalogueC />
			<p class="option-label">Opción E · Lista tipográfica</p>
			<CatalogueE />
			<p class="option-label">Opción G · Índice compacto con productos</p>
			<CatalogueG />
			<p class="option-label">Opción H · Pestañas</p>
			<CatalogueH />
			<p class="option-label">Opción I · Mosaico</p>
			<CatalogueI />
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--font-display: 'Avenir Next Condensed', 'Arial Narrow', 'Roboto Condensed', Impact, sans-serif;
	}

	body {
		margin: 0;
		background: #000;
		font-family: system-ui, sans-serif;
	}
</style>

<style>
	.option-label {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0.75rem 1rem;
		background: #efe3c8;
		color: #000;
		font: 800 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
</style>
