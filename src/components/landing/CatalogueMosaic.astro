---
import type { Category } from '../../data/categories';
import CategoryTile from './CategoryTile.astro';

interface Props {
	categories: readonly Category[];
}

const { categories } = Astro.props;
---

<section id="catalogo" class="catalogue" aria-labelledby="catalogue-title">
	<header class="head">
		<h2 id="catalogue-title">Catálogo</h2>
		<p>Urban denim · Handcrafted · Original</p>
	</header>
	<ul class="mosaic">
		{categories.map((category, i) => (
			<li>
				<CategoryTile category={category} index={i + 1} featured={i === 0} />
			</li>
		))}
	</ul>
</section>

<style>
	.catalogue {
		scroll-margin-top: var(--header-height);
		max-width: var(--page-max);
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6rem) var(--page-gutter);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	h2 {
		margin: 0;
		font: 900 clamp(3rem, 9vw, 7rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.head p {
		margin: 0;
		color: var(--color-accent);
		font: 700 0.8rem/1 var(--font-body);
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	/* The first category is the big tile and the second a wide one; any
	   further categories fill the grid as single tiles. */
	.mosaic {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-rows: minmax(14rem, 34vh);
		grid-auto-flow: dense;
		gap: 4px;
	}

	li:first-child {
		grid-column: span 2;
		grid-row: span 2;
	}

	li:nth-child(2) {
		grid-column: span 2;
	}

	@media (max-width: 760px) {
		.mosaic {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: 22rem;
			grid-auto-rows: 14rem;
		}

		li:first-child {
			grid-row: span 1;
		}

		li:nth-child(2) {
			grid-column: span 1;
		}

		/* With an even count, the last tile would sit alone: let it fill the row. */
		li:last-child:nth-child(even) {
			grid-column: span 2;
		}
	}
</style>
