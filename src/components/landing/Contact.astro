---
import WhatsApp from '../../assets/icons/whatsapp.svg';
import { site } from '../../data/site';
---

<section id="escribenos" class="section contact" aria-labelledby="contact-title">
	<h2 id="contact-title" class="section-title">Escríbenos</h2>
	<p>Pedidos, tallas o dudas. Te respondemos por WhatsApp.</p>
	<a class="stamp cta" href={site.whatsapp} target="_blank" rel="noopener">
		<WhatsApp aria-hidden="true" />
		<span>Abrir WhatsApp</span>
	</a>
</section>

<style>
	/* A slim band between two lines: title, one line of text and the button. */
	.contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-block: clamp(3rem, 6vw, 5rem);
		padding-block: 2.5rem;
		border-block: 1px solid var(--color-line);
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
	}

	p {
		flex: 1 1 16rem;
		margin: 0;
		color: var(--color-muted);
		font-size: 1.125rem;
	}

	.cta {
		--stamp-size: 2.75rem;
	}
</style>
