---
// Option G: the editorial index with products, compacted for the landing
// page. One short band per category with its products in a single row.
import { categories, products } from '../../data/categories';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cat-g" aria-labelledby="cat-g-title">
	<header class="cat-g-head">
		<h2 id="cat-g-title">Catálogo</h2>
		<a href="/catalogo">Ver todo <span aria-hidden="true">→</span></a>
	</header>
	{categories.map((c, i) => (
		<article class="cat-g-band">
			<div class="cat-g-info">
				<span class="cat-g-index">{pad(i + 1)}</span>
				<h3>{c.name}</h3>
				<p>{c.description}</p>
				<a class="cat-g-cta" href={`/catalogo/${c.id}`}>Ver {c.count} <span aria-hidden="true">→</span></a>
			</div>
			<ul class="cat-g-products">
				{products.filter((p) => p.category === c.id).map((p) => (
					<li>
						<a href={`/catalogo/${c.id}/${p.id}`}>
							<span class="cat-g-thumb">
								<img src={p.image} alt="" loading="lazy" decoding="async" />
							</span>
							<span class="cat-g-pname">{p.name}</span>
							<span class="cat-g-price">{p.price}</span>
						</a>
					</li>
				))}
			</ul>
		</article>
	))}
</section>

<style>
	.cat-g {
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 4vw, 3rem);
		color: #fff;
	}

	.cat-g-head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		margin-bottom: 1.5rem;
	}

	.cat-g-head h2 {
		margin: 0;
		font: 900 clamp(3rem, 9vw, 7rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-g-head a,
	.cat-g-cta {
		padding-bottom: 0.25rem;
		border-bottom: 3px solid currentColor;
		color: #fff;
		text-decoration: none;
		font: 800 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.cat-g-head a:hover,
	.cat-g-cta:hover {
		color: #efe3c8;
	}

	.cat-g-band {
		display: grid;
		grid-template-columns: 15rem minmax(0, 1fr);
		gap: clamp(1rem, 3vw, 2.5rem);
		padding: 1.25rem 0;
		border-top: 2px solid #fff;
	}

	.cat-g-info {
		display: grid;
		align-content: start;
		gap: 0.6rem;
	}

	.cat-g-index {
		color: #efe3c8;
		font: 900 1rem/1 var(--font-display);
	}

	.cat-g-info h3 {
		margin: 0;
		font: 900 clamp(2rem, 3.5vw, 3rem)/0.9 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-g-info p {
		margin: 0;
		color: #9a9a9a;
		font: 400 0.9rem/1.45 system-ui, sans-serif;
	}

	.cat-g-cta {
		justify-self: start;
		margin-top: 0.4rem;
	}

	.cat-g-products {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(9rem, calc((100% - 4 * 1rem) / 5));
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.cat-g-products::-webkit-scrollbar {
		display: none;
	}

	.cat-g-products li {
		scroll-snap-align: start;
	}

	.cat-g-products a {
		display: grid;
		gap: 0.3rem;
		color: inherit;
		text-decoration: none;
	}

	.cat-g-thumb {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		background: #111;
		margin-bottom: 0.3rem;
	}

	.cat-g-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0, 0, 1);
	}

	.cat-g-products a:hover img {
		transform: scale(1.06);
	}

	.cat-g-pname {
		font: 800 0.75rem/1.2 system-ui, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cat-g-price {
		color: #9a9a9a;
		font: 400 0.8rem/1 system-ui, sans-serif;
	}

	@media (max-width: 760px) {
		.cat-g-band {
			grid-template-columns: minmax(0, 1fr);
		}

		.cat-g-products {
			grid-auto-columns: 40%;
		}
	}
</style>
