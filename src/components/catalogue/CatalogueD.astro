---
// Option D: editorial index mixed with the catalogue. Each category opens
// with its feature photo and shows its products beside it.
import { categories, products } from '../../data/categories';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cat-d" aria-labelledby="cat-d-title">
	<header class="cat-d-head">
		<p class="cat-d-kicker">Catálogo · {pad(categories.length)} líneas · {products.length} referencias</p>
		<h2 id="cat-d-title">La colección</h2>
	</header>
	{categories.map((c, i) => {
		const items = products.filter((p) => p.category === c.id);
		return (
			<article class="cat-d-block">
				<header class="cat-d-block-head">
					<span class="cat-d-index">{pad(i + 1)}</span>
					<h3>{c.name}</h3>
					<p class="cat-d-desc">{c.description}</p>
					<a class="cat-d-cta" href={`/catalogo/${c.id}`}>Ver todo <span aria-hidden="true">→</span></a>
				</header>
				<div class="cat-d-body">
					<a class="cat-d-feature" href={`/catalogo/${c.id}`} tabindex="-1" aria-hidden="true">
						<img src={c.image} alt="" loading="lazy" decoding="async" />
						<span>Desde {c.fromPrice}</span>
					</a>
					<ul class="cat-d-products">
						{items.map((p) => (
							<li>
								<a href={`/catalogo/${c.id}/${p.id}`}>
									<span class="cat-d-thumb">
										<img src={p.image} alt="" loading="lazy" decoding="async" />
									</span>
									<span class="cat-d-pname">{p.name}</span>
									<span class="cat-d-price">{p.price}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</article>
		);
	})}
</section>

<style>
	.cat-d {
		padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 5vw, 4rem);
		color: #fff;
	}

	.cat-d-head,
	.cat-d-block {
		max-width: 84rem;
		margin-inline: auto;
	}

	.cat-d-head {
		margin-bottom: clamp(3rem, 8vw, 6rem);
	}

	.cat-d-kicker {
		margin: 0 0 0.5rem;
		color: #efe3c8;
		font: 700 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.cat-d-head h2 {
		margin: 0;
		font: 900 clamp(3.5rem, 13vw, 10rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-d-block {
		padding-top: 1.25rem;
		border-top: 2px solid #fff;
		margin-bottom: clamp(4rem, 9vw, 7rem);
	}

	.cat-d-block-head {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas:
			'index name cta'
			'index desc cta';
		column-gap: clamp(1rem, 3vw, 2rem);
		row-gap: 0.75rem;
		align-items: end;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}

	.cat-d-index {
		grid-area: index;
		align-self: start;
		color: #efe3c8;
		font: 900 clamp(1rem, 2vw, 1.5rem)/1 var(--font-display);
	}

	.cat-d-block-head h3 {
		grid-area: name;
		margin: 0;
		font: 900 clamp(2.75rem, 8vw, 6.5rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-d-desc {
		grid-area: desc;
		margin: 0;
		max-width: 32rem;
		color: #9a9a9a;
		font: 400 1rem/1.5 system-ui, sans-serif;
	}

	.cat-d-cta {
		grid-area: cta;
		padding-bottom: 0.25rem;
		border-bottom: 3px solid #fff;
		color: #fff;
		text-decoration: none;
		font: 800 0.9rem/1 system-ui, sans-serif;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.cat-d-cta:hover {
		color: #efe3c8;
		border-color: #efe3c8;
	}

	.cat-d-body {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.cat-d-block:nth-of-type(even) .cat-d-feature {
		order: 2;
	}

	.cat-d-feature {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #111;
	}

	.cat-d-feature img,
	.cat-d-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
	}

	.cat-d-feature span {
		position: absolute;
		left: 0;
		bottom: 0;
		padding: 0.6rem 0.9rem;
		background: #efe3c8;
		color: #000;
		font: 800 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.cat-d-products {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-content: start;
		gap: clamp(1rem, 2vw, 1.5rem);
	}

	.cat-d-products a {
		display: grid;
		gap: 0.4rem;
		color: inherit;
		text-decoration: none;
	}

	.cat-d-thumb {
		display: block;
		aspect-ratio: 1;
		overflow: hidden;
		background: #111;
		margin-bottom: 0.35rem;
	}

	.cat-d-products a:hover img,
	.cat-d-feature:hover img {
		transform: scale(1.05);
	}

	.cat-d-pname {
		font: 800 0.85rem/1.2 system-ui, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cat-d-price {
		color: #9a9a9a;
		font: 400 0.85rem/1 system-ui, sans-serif;
	}

	@media (max-width: 760px) {
		.cat-d-block-head {
			grid-template-columns: auto 1fr;
			grid-template-areas:
				'index name'
				'index desc'
				'index cta';
		}

		.cat-d-cta {
			justify-self: start;
		}

		.cat-d-body {
			grid-template-columns: minmax(0, 1fr);
		}

		.cat-d-block:nth-of-type(even) .cat-d-feature {
			order: 0;
		}

		/* Products become a swipeable strip under the feature photo. */
		.cat-d-products {
			grid-auto-flow: column;
			grid-template-columns: none;
			grid-auto-columns: 42%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.cat-d-products li {
			scroll-snap-align: start;
		}
	}
</style>
