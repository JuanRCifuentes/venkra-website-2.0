---
// Option F: full-screen panels that stack over each other as you scroll.
import { categories } from '../../data/categories';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cat-f" aria-labelledby="cat-f-title">
	<h2 id="cat-f-title" class="cat-f-title">Catálogo</h2>
	{categories.map((c, i) => (
		<a class="cat-f-panel" href={`/catalogo/${c.id}`}>
			<img src={c.image} alt="" loading="lazy" decoding="async" />
			<span class="cat-f-top">
				<span>{pad(i + 1)} / {pad(categories.length)}</span>
				<span>{c.count} referencias</span>
			</span>
			<span class="cat-f-bottom">
				<span class="cat-f-name">{c.name}</span>
				<span class="cat-f-row">
					<span class="cat-f-desc">{c.description}</span>
					<span class="cat-f-cta">Desde {c.fromPrice} <span aria-hidden="true">→</span></span>
				</span>
			</span>
		</a>
	))}
</section>

<style>
	.cat-f {
		color: #fff;
	}

	.cat-f-title {
		margin: 0;
		padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 5vw, 4rem) clamp(2rem, 5vw, 3rem);
		font: 900 clamp(3.5rem, 13vw, 10rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-f-panel {
		position: sticky;
		top: 0;
		display: block;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
		background: #111;
		color: inherit;
		text-decoration: none;
		border-top: 2px solid #000;
	}

	.cat-f-panel img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cat-f-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(0 0 0 / 0.9), transparent 50%),
			linear-gradient(to bottom, rgb(0 0 0 / 0.5), transparent 25%);
	}

	.cat-f-top,
	.cat-f-bottom {
		position: absolute;
		z-index: 1;
		left: clamp(1rem, 5vw, 4rem);
		right: clamp(1rem, 5vw, 4rem);
	}

	.cat-f-top {
		top: 3.5rem;
		display: flex;
		justify-content: space-between;
		font: 700 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.cat-f-bottom {
		bottom: clamp(1.5rem, 5vw, 4rem);
		display: grid;
		gap: 1.25rem;
	}

	.cat-f-name {
		font: 900 clamp(4rem, 16vw, 14rem)/0.8 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-f-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 2px solid #fff;
	}

	.cat-f-desc {
		max-width: 30rem;
		color: #cfcfcf;
		font: 400 1rem/1.5 system-ui, sans-serif;
	}

	.cat-f-cta {
		color: #efe3c8;
		font: 800 0.9rem/1 system-ui, sans-serif;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}
</style>
