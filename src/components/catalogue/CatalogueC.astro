---
// Option C: a stamped marquee band over a horizontal rail of tall cards.
import { categories } from '../../data/categories';
const band = ['Urban denim', 'Handcrafted', 'Original', 'Special goods'];
---

<section class="cat-c" aria-labelledby="cat-c-title">
	<div class="cat-c-band" aria-hidden="true">
		<div class="cat-c-track">
			{[0, 1].map(() => band.map((w) => <span>{w}<b>✦</b></span>))}
		</div>
	</div>
	<header class="cat-c-head">
		<h2 id="cat-c-title">Catálogo</h2>
		<p>{String(categories.length).padStart(2, '0')} líneas <span aria-hidden="true">· Desliza →</span></p>
	</header>
	<ul class="cat-c-rail">
		{categories.map((c, i) => (
			<li>
				<a href={`/catalogo/${c.id}`}>
					<span class="cat-c-media">
						<img src={c.image} alt="" loading="lazy" decoding="async" />
						<span class="cat-c-index">{String(i + 1).padStart(2, '0')}</span>
					</span>
					<span class="cat-c-name">{c.name}</span>
					<span class="cat-c-desc">{c.description}</span>
					<span class="cat-c-meta">
						<span>{c.count} referencias</span>
						<span>Desde {c.fromPrice}</span>
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.cat-c {
		padding: clamp(3rem, 8vw, 6rem) 0;
		color: #fff;
		overflow: hidden;
	}

	.cat-c-band {
		background: #efe3c8;
		color: #000;
		transform: rotate(-2deg);
		margin: 0 -2rem clamp(3rem, 8vw, 5rem);
		padding: 0.6rem 0;
		overflow: hidden;
	}

	.cat-c-track {
		display: flex;
		width: max-content;
		animation: cat-c-roll 24s steps(240) infinite;
	}

	.cat-c-track span {
		font: 900 clamp(1.25rem, 3vw, 2rem)/1 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.cat-c-track b {
		margin: 0 1.5rem;
	}

	@keyframes cat-c-roll {
		to {
			transform: translateX(-50%);
		}
	}

	.cat-c-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		padding: 0 clamp(1rem, 5vw, 4rem) 1.5rem;
	}

	.cat-c-head h2 {
		margin: 0;
		font: 900 clamp(3rem, 10vw, 8rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-c-head p {
		margin: 0;
		color: #9a9a9a;
		font: 700 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.cat-c-rail {
		list-style: none;
		margin: 0;
		padding: 0 clamp(1rem, 5vw, 4rem) 1rem;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(78vw, 24rem);
		gap: clamp(1rem, 2vw, 2rem);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: clamp(1rem, 5vw, 4rem);
		scrollbar-width: none;
	}

	.cat-c-rail::-webkit-scrollbar {
		display: none;
	}

	.cat-c-rail li {
		scroll-snap-align: start;
	}

	.cat-c-rail a {
		display: grid;
		gap: 0.75rem;
		color: inherit;
		text-decoration: none;
	}

	.cat-c-media {
		position: relative;
		display: block;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #111;
	}

	.cat-c-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
	}

	.cat-c-rail a:hover img {
		transform: scale(1.04);
	}

	.cat-c-index {
		position: absolute;
		left: 0;
		bottom: 0;
		padding: 0.5rem 0.75rem;
		background: #000;
		font: 900 1.5rem/1 var(--font-display);
	}

	.cat-c-name {
		margin-top: 0.5rem;
		font: 900 clamp(2rem, 5vw, 3rem)/0.9 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-c-desc {
		color: #9a9a9a;
		font: 400 0.95rem/1.5 system-ui, sans-serif;
	}

	.cat-c-meta {
		display: flex;
		justify-content: space-between;
		padding-top: 0.75rem;
		border-top: 2px solid #fff;
		color: #efe3c8;
		font: 700 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	@media (prefers-reduced-motion: reduce) {
		.cat-c-track {
			animation: none;
		}
	}
</style>
