---
// Option I: a mosaic that fits the four categories in one screen, with the
// first one as the big tile.
import { categories } from '../../data/categories';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cat-i" aria-labelledby="cat-i-title">
	<header class="cat-i-head">
		<h2 id="cat-i-title">Catálogo</h2>
		<p>Urban denim · Handcrafted · Original</p>
	</header>
	<ul class="cat-i-grid">
		{categories.map((c, i) => (
			<li class={`cat-i-cell cat-i-cell-${i + 1}`}>
				<a href={`/catalogo/${c.id}`}>
					<img src={c.image} alt="" loading="lazy" decoding="async" />
					<span class="cat-i-index">{pad(i + 1)}</span>
					<span class="cat-i-bottom">
						<span class="cat-i-name">{c.name}</span>
						<span class="cat-i-price">{c.count} ref. · desde {c.fromPrice}</span>
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.cat-i {
		max-width: 90rem;
		margin: 0 auto;
		padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 4vw, 3rem);
		color: #fff;
	}

	.cat-i-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.cat-i-head h2 {
		margin: 0;
		font: 900 clamp(3rem, 9vw, 7rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-i-head p {
		margin: 0;
		color: #efe3c8;
		font: 700 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.cat-i-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(14rem, 34vh));
		gap: 4px;
	}

	.cat-i-cell-1 {
		grid-column: span 2;
		grid-row: span 2;
	}

	.cat-i-cell-2 {
		grid-column: span 2;
	}

	.cat-i-cell a {
		position: relative;
		display: block;
		height: 100%;
		overflow: hidden;
		background: #111;
		color: inherit;
		text-decoration: none;
	}

	.cat-i-cell img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
	}

	.cat-i-cell a::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgb(0 0 0 / 0.85), transparent 55%);
	}

	.cat-i-cell a:hover img {
		transform: scale(1.04);
	}

	.cat-i-cell a:hover {
		outline: 3px solid #efe3c8;
		outline-offset: -3px;
	}

	.cat-i-index {
		position: absolute;
		z-index: 1;
		top: 0;
		left: 0;
		padding: 0.5rem 0.75rem;
		background: #000;
		font: 900 1.1rem/1 var(--font-display);
	}

	.cat-i-bottom {
		position: absolute;
		z-index: 1;
		left: clamp(0.75rem, 2vw, 1.5rem);
		right: clamp(0.75rem, 2vw, 1.5rem);
		bottom: clamp(0.75rem, 2vw, 1.5rem);
		display: grid;
		gap: 0.5rem;
	}

	.cat-i-name {
		font: 900 clamp(1.75rem, 3.5vw, 3rem)/0.9 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.cat-i-cell-1 .cat-i-name {
		font-size: clamp(2.75rem, 7vw, 6rem);
	}

	.cat-i-price {
		color: #efe3c8;
		font: 700 0.7rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	@media (max-width: 760px) {
		.cat-i-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: 22rem repeat(2, 14rem);
		}

		.cat-i-cell-1 {
			grid-row: span 1;
		}

		.cat-i-cell-2 {
			grid-column: span 1;
		}

		.cat-i-cell-4 {
			grid-column: span 2;
		}
	}
</style>
