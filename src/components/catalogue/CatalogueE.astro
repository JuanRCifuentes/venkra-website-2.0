---
// Option E: a typographic list. Giant outlined names fill in on hover and
// the category photo is stamped beside them.
import { categories } from '../../data/categories';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="cat-e" aria-labelledby="cat-e-title">
	<h2 id="cat-e-title">Catálogo</h2>
	<ul class="cat-e-list">
		{categories.map((c, i) => (
			<li>
				<a href={`/catalogo/${c.id}`}>
					<span class="cat-e-index">{pad(i + 1)}</span>
					<span class="cat-e-name">{c.name}</span>
					<span class="cat-e-meta">
						<span>{c.count} ref.</span>
						<span>Desde {c.fromPrice}</span>
					</span>
					<span class="cat-e-photo" style={`--tilt: ${i % 2 ? 3 : -3}deg`}>
						<img src={c.image} alt="" loading="lazy" decoding="async" />
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.cat-e {
		padding: clamp(4rem, 10vw, 8rem) clamp(1rem, 5vw, 4rem);
		color: #fff;
		overflow: hidden;
	}

	.cat-e h2 {
		max-width: 84rem;
		margin: 0 auto 2rem;
		color: #efe3c8;
		font: 700 0.8rem/1 system-ui, sans-serif;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.cat-e-list {
		list-style: none;
		max-width: 84rem;
		margin: 0 auto;
		padding: 0;
		border-bottom: 2px solid #fff;
	}

	.cat-e-list li {
		border-top: 2px solid #fff;
	}

	.cat-e-list a {
		position: relative;
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		align-items: center;
		gap: 1rem;
		padding: clamp(1rem, 2.5vw, 2rem) 0;
		color: inherit;
		text-decoration: none;
	}

	.cat-e-index {
		align-self: start;
		color: #efe3c8;
		font: 900 1.25rem/1 var(--font-display);
	}

	.cat-e-name {
		position: relative;
		z-index: 2;
		font: 900 clamp(3.5rem, 12vw, 10rem)/0.85 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
		color: transparent;
		-webkit-text-stroke: 2px #fff;
		transition: color 0.2s steps(2);
	}

	.cat-e-list a:hover .cat-e-name,
	.cat-e-list a:focus-visible .cat-e-name {
		color: #fff;
	}

	.cat-e-meta {
		position: relative;
		z-index: 2;
		display: grid;
		gap: 0.5rem;
		justify-items: end;
		font: 700 0.75rem/1 system-ui, sans-serif;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.cat-e-meta span:last-child {
		color: #efe3c8;
	}

	.cat-e-photo {
		position: absolute;
		z-index: 1;
		right: 18%;
		top: 50%;
		width: clamp(10rem, 22vw, 18rem);
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border: 6px solid #fff;
		opacity: 0;
		transform: translateY(-50%) rotate(var(--tilt)) scale(0.9);
		transition: opacity 0.15s steps(2), transform 0.25s cubic-bezier(0.2, 0, 0, 1);
		pointer-events: none;
	}

	.cat-e-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cat-e-list a:hover .cat-e-photo,
	.cat-e-list a:focus-visible .cat-e-photo {
		opacity: 1;
		transform: translateY(-50%) rotate(var(--tilt));
	}

	/* No hover on touch screens: show the photo as a thumbnail instead. */
	@media (hover: none), (max-width: 640px) {
		.cat-e-list a {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'photo photo'
				'name meta';
		}

		.cat-e-index {
			display: none;
		}

		.cat-e-name {
			grid-area: name;
			color: #fff;
			-webkit-text-stroke: 0;
			font-size: clamp(2.5rem, 12vw, 5rem);
		}

		.cat-e-meta {
			grid-area: meta;
			align-self: end;
		}

		.cat-e-photo,
		.cat-e-list a:hover .cat-e-photo {
			grid-area: photo;
			position: static;
			width: 100%;
			aspect-ratio: 16 / 10;
			border: 0;
			opacity: 1;
			transform: none;
		}
	}
</style>
