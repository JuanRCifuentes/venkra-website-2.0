---
import type { HTMLAttributes } from 'astro/types';
import { getImage } from 'astro:assets';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> {
	src: string;
	/** How wide the photo shows, so the browser picks the smallest width that fills it. */
	sizes: string;
}

// Catalogue photos are full-size JPEGs on postimg. The build downloads each one
// and serves it from /_astro as WebP in a few widths, so phones get a fraction
// of the original and the pages no longer depend on postimg being up.
const WIDTHS = [320, 640, 960, 1280, 1600];

const { src, ...attrs } = Astro.props;
const image = await getImage({ src, inferSize: true, widths: WIDTHS, format: 'webp' });
---

{/* One spread, so the caller's loading or decoding replaces the default instead of repeating it. */}
<img src={image.src} srcset={image.srcSet.attribute} {...{ ...image.attributes, ...attrs }} />
